{
  "buildCommand": "npm ci && npm run build",
  "outputDirectory": "public",
  "devCommand": "php artisan serve",
  "rewrites": [
    {
      "source": "/build/(.*)",
      "destination": "/build/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  }
}